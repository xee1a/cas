---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { Person } from '../people';
import T from '../components/T.astro';

interface Props {
  title: string;
  description?: string;
  person?: Person; // when set, the header is scoped to that person's portfolio
}

const { title, description = 'CAS Portfolio. Creativity, Activity, Service (IB Diploma Programme).', person } =
  Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = person ? `${base}${person.slug}/` : base;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      // Apply the saved theme before first paint so there is no flash.
      // The <html> element persists across view transitions, so this holds.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          document.documentElement.dataset.theme = t === 'neutral' || t === 'light' ? t : 'dark';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
        try {
          document.documentElement.dataset.lang = localStorage.getItem('lang') === 'pl' ? 'pl' : 'en';
        } catch (e) {
          document.documentElement.dataset.lang = 'en';
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <canvas id="fx" aria-hidden="true" transition:persist></canvas>
    <header class="site-header">
      <div class="wrap">
        <div class="header-left">
          <a class="home-icon" href={base} aria-label="All portfolios">
            <span class="ib-mark" aria-hidden="true"></span>
          </a>
          {person ? (
            <a class="brand" href={home}>{person.name} <span>· CAS</span></a>
          ) : (
            <a class="brand" href={base}><T en="CAS Portfolios" pl="Portfolia CAS" /></a>
          )}
        </div>
        <div class="header-right">
          <nav class="nav">
            {person && <a href={`${base}${person.slug}/reflections/`}><T en="Experiences" pl="Doświadczenia" /></a>}
            {person && <a href={`${base}${person.slug}/progress/`}><T en="Progress" pl="Postępy" /></a>}
            <a href={`${base}learning-outcomes/`}><T en="Learning Outcomes" pl="Efekty uczenia się" /></a>
            <a href={base}><T en="Portfolios" pl="Portfolia" /></a>
            <a class="nav-cta" href={`${base}panel/`}><T en="Panel" pl="Panel" /></a>
          </nav>
          <div class="lang-switch" role="group" aria-label="Language">
            <button type="button" class="lang-btn" data-lang-set="en">EN</button>
            <button type="button" class="lang-btn" data-lang-set="pl">PL</button>
          </div>
          <div class="theme-switch" role="group" aria-label="Theme">
            <button type="button" class="sw sw-dark" data-theme-set="dark" aria-label="Dark theme"></button>
            <button type="button" class="sw sw-neutral" data-theme-set="neutral" aria-label="Neutral theme"></button>
            <button type="button" class="sw sw-light" data-theme-set="light" aria-label="Light theme"></button>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <T en="CAS Portfolio" pl="Portfolio CAS" /> · <T en="IB Diploma Programme" pl="Program IB Diploma" /> · <a class="egg" href={`${base}four-player-chess/`}><T en="Creativity" pl="Kreatywność" /></a> · <T en="Activity" pl="Aktywność" /> · <T en="Service" pl="Służba" /> · <a href={`${base}panel/`}><T en="Panel" pl="Panel" /></a>
      </div>
    </footer>

    <script>
      // Theme switcher (dark / neutral / light). Attached once on document,
      // so it keeps working across view-transition navigations.
      {
        const tw = window as any;
        const savedTheme = () => {
          try {
            const t = localStorage.getItem('theme');
            return t === 'neutral' || t === 'light' ? t : 'dark';
          } catch (err) {
            return 'dark';
          }
        };
        // A view-transition swap replaces <html>'s attributes with the incoming
        // (server-rendered) page's, which carry no theme, so re-apply it.
        const applyTheme = () => {
          document.documentElement.dataset.theme = savedTheme();
        };
        const syncTheme = () => {
          const t = document.documentElement.dataset.theme || 'dark';
          document.querySelectorAll('[data-theme-set]').forEach((b) => {
            b.setAttribute('aria-pressed', String(b.getAttribute('data-theme-set') === t));
          });
        };

        // Language (en / pl). Same lifecycle as the theme: persisted, applied
        // before paint, and re-applied after each view-transition swap.
        const savedLang = () => {
          try { return localStorage.getItem('lang') === 'pl' ? 'pl' : 'en'; } catch (err) { return 'en'; }
        };
        const applyLang = () => { document.documentElement.dataset.lang = savedLang(); };
        const syncLang = () => {
          const l = document.documentElement.dataset.lang || 'en';
          document.querySelectorAll('[data-lang-set]').forEach((b) => {
            b.setAttribute('aria-pressed', String(b.getAttribute('data-lang-set') === l));
          });
        };

        if (!tw.__themeInit) {
          tw.__themeInit = true;
          document.addEventListener('click', (e) => {
            const themeBtn = (e.target as HTMLElement).closest('[data-theme-set]');
            if (themeBtn) {
              const t = themeBtn.getAttribute('data-theme-set') as string;
              document.documentElement.dataset.theme = t;
              try { localStorage.setItem('theme', t); } catch (err) {}
              syncTheme();
              return;
            }
            const langBtn = (e.target as HTMLElement).closest('[data-lang-set]');
            if (langBtn) {
              const l = langBtn.getAttribute('data-lang-set') as string;
              document.documentElement.dataset.lang = l;
              try { localStorage.setItem('lang', l); } catch (err) {}
              syncLang();
              document.dispatchEvent(new CustomEvent('langchange', { detail: l }));
            }
          });
          document.addEventListener('astro:after-swap', () => { applyTheme(); applyLang(); });
          document.addEventListener('astro:page-load', () => { syncTheme(); syncLang(); });
        }
        applyTheme();
        applyLang();
        syncTheme();
        syncLang();
      }
    </script>

    <script>
      // WebGL fluid simulation that swirls under the cursor (decorative background).
      import fluidCursor from 'webgl-fluid';

      const w = window as any;
      const canvas = document.getElementById('fx') as HTMLCanvasElement | null;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // The canvas persists across view-transition navigations, so init only once.
      if (canvas && !reduce && !w.__fxInit) {
        w.__fxInit = true;
        try {
          fluidCursor(canvas, {
            TRIGGER: 'hover',
            IMMEDIATE: false,
            AUTO: false,
            SIM_RESOLUTION: 128,
            DYE_RESOLUTION: 1024,
            DENSITY_DISSIPATION: 5.5,
            VELOCITY_DISSIPATION: 2.5,
            PRESSURE: 0.8,
            PRESSURE_ITERATIONS: 20,
            CURL: 26,
            SPLAT_RADIUS: 0.14,
            SPLAT_FORCE: 5200,
            SHADING: true,
            COLORFUL: true,
            COLOR_UPDATE_SPEED: 10,
            TRANSPARENT: true,
            BACK_COLOR: { r: 0, g: 0, b: 0 },
            BLOOM: true,
            BLOOM_INTENSITY: 0.4,
            SUNRAYS: false,
          });

          // The canvas sits behind the page (pointer-events: none), so forward the
          // window's pointer position to it. The canvas is full-viewport at (0,0),
          // so offsetX/offsetY equal clientX/clientY.
          const forward = (type: string, x: number, y: number) => {
            const ev = new MouseEvent(type, { clientX: x, clientY: y, bubbles: false });
            Object.defineProperty(ev, 'offsetX', { value: x });
            Object.defineProperty(ev, 'offsetY', { value: y });
            canvas.dispatchEvent(ev);
          };
          window.addEventListener('pointerdown', (e) => forward('mousedown', e.clientX, e.clientY), { passive: true });
          window.addEventListener('pointermove', (e) => forward('mousemove', e.clientX, e.clientY), { passive: true });
        } catch (err) {
          // WebGL unavailable — no background effect, page works normally.
        }
      }
    </script>
  </body>
</html>
