---
import type { CollectionEntry } from 'astro:content';
import T from './T.astro';
import { STRAND_PL } from '../i18n';

interface Props {
  posts: CollectionEntry<'reflections'>[];
  person: string; // slug, for building links
}
const { posts, person } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

{posts.length === 0 ? (
  <p class="empty"><T en="No experiences here yet." pl="Jeszcze nie ma tu doświadczeń." /></p>
) : (
  <ul class="posts">
    {posts.map((post) => (
      <li class="post-item" data-strands={post.data.strands.join(',')}>
        <a class="post-card" href={`${base}${person}/reflections/${post.id}/`}>
          <div class="post-meta">
            {post.data.strands.map((s) => (
              <span class={`chip ${s}`}><T en={s} pl={STRAND_PL[s]} /></span>
            ))}
            <span class="post-date">{fmtDate(post.data.date)}</span>
          </div>
          <h3 class="post-title">{post.data.title}</h3>
          {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
          {post.data.learningOutcomes.length > 0 && (
            <div class="lo-tags">
              {post.data.learningOutcomes.sort((a, b) => a - b).map((lo) => (
                <span class="lo-tag">LO{lo}</span>
              ))}
            </div>
          )}
        </a>
      </li>
    ))}
  </ul>
)}
