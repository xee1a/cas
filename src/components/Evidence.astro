---
interface Img { src: string; caption?: string }
interface Att { src: string; label: string }
interface Props { gallery?: Img[]; attachments?: Att[] }

const { gallery = [], attachments = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resolve = (s: string) => (s.startsWith('http') ? s : base + s.replace(/^\//, ''));
---

{(gallery.length > 0 || attachments.length > 0) && (
  <section class="evidence">
    <h2 class="evidence-title">Evidence</h2>

    {gallery.length > 0 && (
      <div class="gallery">
        {gallery.map((g) => (
          <figure class="gallery-item">
            <a href={resolve(g.src)} target="_blank" rel="noopener">
              <img src={resolve(g.src)} alt={g.caption ?? 'Zdjęcie'} loading="lazy" />
            </a>
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    {attachments.length > 0 && (
      <div class="attachments">
        {attachments.map((a) => (
          <a class="attachment" href={resolve(a.src)} target="_blank" rel="noopener">
            <span class="att-icon">PDF</span>
            <span class="att-label">{a.label}</span>
            <span class="att-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    )}
  </section>
)}

<style>
  .evidence { margin: 36px 0 8px; }
  .evidence-title {
    font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--muted); margin: 0 0 16px;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 12px;
  }
  .gallery-item { margin: 0; }
  .gallery-item a { display: block; }
  .gallery-item img {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: 12px; border: 1px solid var(--border); display: block;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .gallery-item a:hover img { transform: translateY(-2px); box-shadow: var(--shadow); }
  .gallery-item figcaption { font-size: 0.82rem; color: var(--muted); margin-top: 6px; }

  .attachments { display: grid; gap: 10px; margin-top: 14px; }
  .attachment {
    display: flex; align-items: center; gap: 12px;
    text-decoration: none; color: var(--text);
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 12px; padding: 12px 16px;
    transition: border-color 0.15s, transform 0.15s;
  }
  .attachment:hover { border-color: var(--muted); transform: translateY(-1px); }
  .att-icon {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.03em;
    color: #fff; background: #d64545; border-radius: 6px;
    padding: 4px 7px; flex-shrink: 0;
  }
  .att-label { font-weight: 600; font-size: 0.95rem; flex: 1; }
  .att-arrow { color: var(--muted); }
</style>
