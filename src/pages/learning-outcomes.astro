---
import { LEARNING_OUTCOMES_FULL } from '../learning-outcomes';
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Learning Outcomes · CAS">
  <section class="lo-page wrap">
    <a class="back-link" href={base}>&larr; <T en="Portfolios" pl="Portfolia" /></a>
    <header class="lo-intro">
      <p class="tagline">CAS · <T en="IB Diploma Programme" pl="Program IB Diploma" /></p>
      <h1><T en="The 7 Learning Outcomes" pl="7 efektów uczenia się" /></h1>
      <p class="lede">
        <T
          en="To complete CAS, a student must show evidence for all seven learning outcomes across their Creativity, Activity and Service experiences. Here's what each one means."
          pl="Aby ukończyć CAS, uczeń musi wykazać dowody dla wszystkich siedmiu efektów uczenia się w swoich doświadczeniach z Kreatywności, Aktywności i Służby. Oto co oznacza każdy z nich."
        />
      </p>
    </header>

    <ol class="lo-cards">
      {LEARNING_OUTCOMES_FULL.map((lo) => (
        <li class="lo-card">
          <div class="lo-num">LO{lo.n}</div>
          <div class="lo-content">
            <h2><T en={lo.title} pl={lo.titlePl} /></h2>
            <p class="lo-plain"><T en={lo.plain} pl={lo.plainPl} /></p>
            <p class="lo-how"><span><T en="How you show it" pl="Jak to pokazać" /></span><T en={lo.how} pl={lo.howPl} /></p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
