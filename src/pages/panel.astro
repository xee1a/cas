---
// Panel for adding CAS entries. Sign in with Google; only accounts listed under
// `editors` in the Firebase Realtime Database can post (see database.rules.json).
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import { PEOPLE } from '../people';
import { LEARNING_OUTCOMES_FULL } from '../learning-outcomes';
import { STRAND_PL, STRAND_SUB_EN, STRAND_SUB_PL } from '../i18n';

const STRANDS = ['Creativity', 'Activity', 'Service', 'Project'];
---

<BaseLayout title="Panel · CAS">
  <section class="panel wrap">
    <h1 class="panel-title"><T en="Panel" pl="Panel" /></h1>

    <!-- Signed out -->
    <div class="p-card" id="p-signin" hidden>
      <p><T en="Sign in with the Google account that's on the list." pl="Zaloguj się kontem Google, które jest na liście." /></p>
      <button type="button" class="p-btn primary" id="p-google">
        <T en="Sign in with Google" pl="Zaloguj przez Google" />
      </button>
      <p class="p-msg" id="p-signin-msg"></p>
    </div>

    <!-- Signed in, not on the list -->
    <div class="p-card" id="p-denied" hidden>
      <p>
        <T en="This account can't post yet:" pl="To konto nie może jeszcze dodawać wpisów:" />
        <strong id="p-denied-email"></strong>
      </p>
      <p class="p-hint"><T en="Send this email address to Alex to get added." pl="Wyślij ten adres Alexowi, żeby dostać dostęp." /></p>
      <button type="button" class="p-btn" data-signout><T en="Sign out" pl="Wyloguj" /></button>
    </div>

    <!-- Editor -->
    <div id="p-editor" hidden>
      <div class="p-bar">
        <span class="p-who">
          <span id="p-email"></span> ·
          <T en="managing" pl="zarządzasz" />
          <strong id="p-person-name"></strong>
          <select id="p-person-select" hidden>
            {PEOPLE.map((p) => <option value={p.slug}>{p.name}</option>)}
          </select>
        </span>
        <button type="button" class="p-link" data-signout><T en="Sign out" pl="Wyloguj" /></button>
      </div>

      <div class="p-tabs" role="tablist">
        <button type="button" class="p-tab" role="tab" data-tab="posts" aria-selected="true"><T en="Posts" pl="Wpisy" /></button>
        <button type="button" class="p-tab" role="tab" data-tab="comments" aria-selected="false">
          <T en="Comments" pl="Komentarze" /> <span class="p-count" id="p-c-count"></span>
        </button>
        <button type="button" class="p-tab" role="tab" data-tab="project" aria-selected="false"><T en="CAS project" pl="Projekt CAS" /></button>
      </div>

      <div data-pane="posts">
      <form id="p-form" class="p-card" novalidate>
        <h2 class="p-form-title">
          <span id="p-mode-new"><T en="New entry" pl="Nowy wpis" /></span>
          <span id="p-mode-edit" hidden><T en="Editing entry" pl="Edycja wpisu" /></span>
        </h2>

        <fieldset class="p-field">
          <legend><T en="Strand" pl="Obszar" /></legend>
          <div class="p-strands">
            {STRANDS.map((s) => (
              <label class={`p-strand ${s}`}>
                <input type="radio" name="strand" value={s} required />
                <span class="p-strand-name"><T en={s} pl={STRAND_PL[s]} /></span>
                <span class="p-strand-sub"><T en={STRAND_SUB_EN[s]} pl={STRAND_SUB_PL[s]} /></span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="p-row">
          <label class="p-field grow">
            <span><T en="Title" pl="Tytuł" /></span>
            <input name="title" type="text" maxlength="150" required data-ph-en="e.g. Volunteering at the animal shelter" data-ph-pl="np. Wolontariat w schronisku" />
          </label>
          <label class="p-field">
            <span><T en="Date" pl="Data" /></span>
            <input name="date" type="date" required />
          </label>
        </div>

        <label class="p-field">
          <span><T en="Short description" pl="Krótki opis" /> <em><T en="shown in the list" pl="widoczny na liście" /></em></span>
          <textarea name="summary" rows="2" maxlength="400" data-ph-en="One or two sentences about what you did." data-ph-pl="Jedno–dwa zdania o tym, co robiłeś."></textarea>
        </label>

        <div class="p-field">
          <span class="p-label-row">
            <span><T en="Reflection" pl="Refleksja" /></span>
            <button type="button" class="p-ai-btn" id="p-ai" hidden><T en="Write with AI" pl="Napisz z AI" /></button>
          </span>
          <textarea name="reflection" rows="12" maxlength="20000" data-ph-en={"What did you plan? What did you do? What went well or badly, what did you learn, what would you do differently?\n\nLeave an empty line between paragraphs. Start a line with \"## \" for a heading."} data-ph-pl={"Co planowałeś? Co zrobiłeś? Co poszło dobrze, a co źle, czego się nauczyłeś, co zrobiłbyś inaczej?\n\nZostaw pustą linię między akapitami. Zacznij linię od \"## \", żeby zrobić nagłówek."}></textarea>
          <span class="p-msg p-ai-msg" id="p-ai-msg"></span>
          <span class="p-ai-note p-hint" id="p-ai-note" hidden><T en="AI writes a rough first draft from your title, strand and outcomes. Always read it and make it your own." pl="AI pisze wstępny szkic na podstawie tytułu, obszaru i efektów. Zawsze przeczytaj go i napisz po swojemu." /></span>
        </div>

        <fieldset class="p-field">
          <legend><T en="Learning outcomes" pl="Efekty uczenia się" /></legend>
          <div class="p-los">
            {LEARNING_OUTCOMES_FULL.map((lo) => (
              <label class="p-lo">
                <input type="checkbox" name="lo" value={lo.n} />
                <span class="p-lo-n">LO{lo.n}</span>
                <span class="p-lo-t"><T en={lo.title} pl={lo.titlePl} /></span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="p-field p-hours">
          <span><T en="CAS hours" pl="Godziny CAS" /> <em><T en="optional" pl="opcjonalnie" /></em></span>
          <input name="hours" type="number" min="0" max="1000" step="0.5" />
        </label>

        <div class="p-field">
          <span><T en="Photos" pl="Zdjęcia" /> <em><T en="resized automatically" pl="zmniejszane automatycznie" /></em></span>
          <label class="p-drop" id="p-drop">
            <input type="file" accept="image/*" multiple id="p-files" />
            <T en="Click or drop photos here" pl="Kliknij albo upuść zdjęcia tutaj" />
          </label>
          <div class="p-photos" id="p-photos"></div>
        </div>

        <div class="p-field">
          <span><T en="Video" pl="Wideo" /> <em><T en="optional" pl="opcjonalnie" /></em></span>
          <label class="p-drop p-vid-drop" id="p-vid-drop" hidden>
            <input type="file" accept="video/mp4,video/webm,video/ogg,video/quicktime" id="p-vid-file" />
            <T en="Click or drop a video here (MP4/WebM/MOV, up to 100 MB)" pl="Kliknij albo upuść wideo tutaj (MP4/WebM/MOV, do 100 MB)" />
          </label>
          <div class="p-vid-progress" id="p-vid-progress" hidden><div class="p-vid-bar" id="p-vid-bar"></div></div>
          <div class="p-vid-current" id="p-vid-current" hidden>
            <span class="p-vid-name" id="p-vid-name"></span>
            <button type="button" class="p-link" id="p-vid-clear"><T en="Remove" pl="Usuń" /></button>
          </div>
          <span class="p-msg p-vid-msg" id="p-vid-msg"></span>
          <details class="p-vid-link">
            <summary><T en="or paste a YouTube / Vimeo / video link" pl="albo wklej link do YouTube / Vimeo / wideo" /></summary>
            <input name="video" type="url" maxlength="400" data-ph-en="https://youtube.com/watch?v=..." data-ph-pl="https://youtube.com/watch?v=..." />
          </details>
        </div>

        <div class="p-actions">
          <p class="p-msg" id="p-msg"></p>
          <button type="button" class="p-btn" id="p-cancel" hidden><T en="Cancel" pl="Anuluj" /></button>
          <button type="submit" class="p-btn primary" id="p-save">
            <span id="p-save-new"><T en="Publish" pl="Opublikuj" /></span>
            <span id="p-save-edit" hidden><T en="Save changes" pl="Zapisz zmiany" /></span>
          </button>
        </div>
      </form>

      <h2 class="p-list-title"><T en="Entries added here" pl="Wpisy dodane tutaj" /></h2>
      <ul class="p-list" id="p-list"></ul>
      </div>

      <div data-pane="comments" hidden>
        <p class="p-hint"><T en="Notes visitors left on your portfolio page. Deleting one removes it for everyone." pl="Notatki zostawione przez odwiedzających na twojej stronie. Usunięcie usuwa je dla wszystkich." /></p>
        <ul class="p-comments" id="p-comments"></ul>
      </div>

      <div data-pane="project" hidden>
        <p class="p-hint"><T en="Your CAS project plan. It's shown at the top of your Project page. Add updates about the project as normal posts with the Project category." pl="Plan twojego projektu CAS. Pojawia się na górze strony Projekt. Postępy dodawaj jako zwykłe wpisy z kategorią Projekt." /></p>
        <form id="p-proj-form" class="p-card" novalidate>
          <div class="p-row">
            <label class="p-field grow">
              <span><T en="Project title" pl="Nazwa projektu" /></span>
              <input name="title" type="text" maxlength="150" data-ph-en="e.g. Charity football tournament" data-ph-pl="np. Charytatywny turniej piłkarski" />
            </label>
            <label class="p-field">
              <span><T en="Status" pl="Status" /></span>
              <select name="status" class="p-select">
                <option value="planning">Planning / Planowanie</option>
                <option value="active">In progress / W trakcie</option>
                <option value="done">Completed / Ukończony</option>
              </select>
            </label>
          </div>

          <fieldset class="p-field">
            <legend><T en="Area" pl="Obszar" /></legend>
            <div class="p-areas">
              {['Creativity', 'Activity', 'Service'].map((s) => (
                <label class={`p-area ${s}`}>
                  <input type="checkbox" name="areas" value={s} />
                  <T en={s} pl={STRAND_PL[s]} />
                </label>
              ))}
            </div>
          </fieldset>

          <div class="p-row">
            <label class="p-field grow">
              <span><T en="Duration" pl="Czas trwania" /></span>
              <input name="duration" type="text" maxlength="100" data-ph-en="e.g. Oct 2026 – Jan 2027" data-ph-pl="np. paź 2026 – sty 2027" />
            </label>
            <label class="p-field grow">
              <span><T en="Team" pl="Zespół" /></span>
              <input name="team" type="text" maxlength="300" data-ph-en="Who you're doing it with" data-ph-pl="Z kim to robisz" />
            </label>
          </div>

          <label class="p-field">
            <span><T en="Goal" pl="Cel" /></span>
            <textarea name="goal" rows="3" maxlength="4000" data-ph-en="What do you want to achieve, and for whom?" data-ph-pl="Co chcesz osiągnąć i dla kogo?"></textarea>
          </label>
          <label class="p-field">
            <span><T en="How to achieve it?" pl="Jak to osiągnąć?" /></span>
            <textarea name="how" rows="4" maxlength="4000" data-ph-en="Steps, roles, resources, timeline." data-ph-pl="Kroki, role, zasoby, harmonogram."></textarea>
          </label>
          <label class="p-field">
            <span><T en="Outcomes" pl="Rezultaty" /></span>
            <textarea name="outcomes" rows="3" maxlength="4000" data-ph-en="What will come out of it (or what did)?" data-ph-pl="Co z tego wyniknie (albo wynikło)?"></textarea>
          </label>
          <label class="p-field">
            <span><T en="Possible problems" pl="Możliwe problemy" /></span>
            <textarea name="problems" rows="3" maxlength="4000" data-ph-en="What could go wrong, and how you'll handle it." data-ph-pl="Co może pójść nie tak i jak sobie z tym poradzisz."></textarea>
          </label>

          <div class="p-actions">
            <p class="p-msg" id="p-proj-msg"></p>
            <button type="button" class="p-btn danger" id="p-proj-delete" hidden><T en="Delete plan" pl="Usuń plan" /></button>
            <button type="submit" class="p-btn primary"><T en="Save project" pl="Zapisz projekt" /></button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .panel { max-width: 760px; padding-bottom: 60px; }
  .panel-title { font-family: var(--serif); font-size: 2.2rem; margin: 36px 0 22px; }
  .p-card { border: 1px solid var(--border); background: var(--surface); border-radius: 14px; padding: 22px; }
  .p-card p { margin: 0 0 14px; }
  .p-hint { color: var(--muted); font-size: 0.92rem; }
  .p-bar { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; margin-bottom: 14px; color: var(--muted); font-size: 0.92rem; }
  .p-who strong { color: var(--text); }
  .p-who select { font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 4px 8px; }
  .p-form-title { font-size: 1.15rem; margin: 0 0 18px; }
  .p-field { display: flex; flex-direction: column; gap: 6px; margin: 0 0 18px; border: 0; padding: 0; min-width: 0; }
  .p-field > span, .p-field legend { font-weight: 600; font-size: 0.9rem; padding: 0; margin-bottom: 6px; }
  .p-label-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .p-ai-btn {
    font: inherit; font-weight: 600; font-size: 0.82rem; cursor: pointer;
    border: 1px solid var(--border); background: var(--bg); color: var(--text);
    border-radius: 999px; padding: 4px 12px; margin: 0;
  }
  .p-ai-btn:hover { border-color: var(--text); }
  .p-ai-btn:disabled { opacity: 0.5; cursor: default; }
  .p-ai-msg:empty { display: none; }
  .p-ai-msg { margin-top: 6px; }
  .p-ai-note { margin-top: 6px; font-weight: 400; }
  .p-field em { font-style: normal; font-weight: 400; color: var(--muted); }
  .p-field input:not([type='radio']):not([type='checkbox']):not([type='file']), .p-field textarea {
    font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--border);
    border-radius: 9px; padding: 10px 12px; width: 100%; box-sizing: border-box; resize: vertical;
  }
  .p-field input:focus, .p-field textarea:focus { outline: none; border-color: var(--text); }
  .p-field input[type='date'] { color-scheme: dark; }
  :root[data-theme='light'] .p-field input[type='date'] { color-scheme: light; }
  .p-row { display: flex; gap: 14px; flex-wrap: wrap; }
  .p-row .grow { flex: 1 1 260px; }
  .p-hours input { max-width: 140px; }

  .p-strands { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  @media (max-width: 700px) { .p-strands { grid-template-columns: 1fr 1fr; } }
  .p-strand {
    --c: var(--muted);
    position: relative; cursor: pointer; border: 1.5px solid var(--border); border-radius: 12px;
    padding: 14px; display: flex; flex-direction: column; gap: 3px; background: var(--bg);
    transition: border-color 0.15s, background 0.15s;
  }
  .p-strand.Creativity { --c: var(--creativity); }
  .p-strand.Activity { --c: var(--activity); }
  .p-strand.Service { --c: var(--service); }
  .p-strand.Project { --c: var(--project); }
  .p-strand input { position: absolute; opacity: 0; pointer-events: none; }
  .p-strand-name { font-weight: 700; color: var(--c); }
  .p-strand-sub { font-size: 0.82rem; color: var(--muted); }
  .p-strand:hover { border-color: var(--c); }
  .p-strand:has(input:checked) { border-color: var(--c); background: color-mix(in srgb, var(--c) 14%, var(--bg)); }
  .p-strand:has(input:focus-visible) { outline: 2px solid var(--c); outline-offset: 2px; }

  .p-los { display: flex; flex-direction: column; gap: 6px; }
  .p-lo {
    display: flex; gap: 10px; align-items: center; cursor: pointer; border: 1px solid var(--border);
    border-radius: 9px; padding: 8px 12px; background: var(--bg); font-size: 0.92rem;
  }
  .p-lo input { accent-color: var(--text); width: 16px; height: 16px; flex-shrink: 0; }
  .p-lo-n { font-weight: 700; font-size: 0.8rem; color: var(--muted); min-width: 30px; }
  .p-lo:has(input:checked) { border-color: var(--text); }
  .p-lo:has(input:checked) .p-lo-n { color: var(--text); }

  .p-drop {
    display: block; border: 1.5px dashed var(--border); border-radius: 12px; padding: 22px;
    text-align: center; color: var(--muted); cursor: pointer; background: var(--bg); font-size: 0.92rem;
  }
  .p-drop:hover, .p-drop.over { border-color: var(--text); color: var(--text); }
  .p-drop input { display: none; }
  .p-photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-top: 10px; }
  .p-photo { position: relative; display: flex; flex-direction: column; gap: 6px; }
  .p-photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 9px; border: 1px solid var(--border); display: block; }
  .p-photo input { font: inherit; font-size: 0.82rem; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: 7px; padding: 5px 8px; }
  .p-photo .p-x {
    position: absolute; top: 6px; right: 6px; width: 26px; height: 26px; border-radius: 50%; border: 0;
    background: rgb(0 0 0 / 0.65); color: #fff; cursor: pointer; font-size: 15px; line-height: 1;
  }
  .p-photo.busy { opacity: 0.5; }

  .p-vid-drop { margin: 0; }
  .p-vid-progress { height: 8px; border-radius: 999px; background: var(--bg); border: 1px solid var(--border); overflow: hidden; margin-top: 10px; }
  .p-vid-bar { height: 100%; width: 0; background: var(--text); transition: width 0.15s ease; }
  .p-vid-current { display: flex; align-items: center; gap: 12px; margin-top: 10px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 9px; background: var(--bg); }
  .p-vid-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.9rem; }
  .p-vid-msg:empty { display: none; }
  .p-vid-msg { margin-top: 8px; }
  .p-vid-link { margin-top: 10px; }
  .p-vid-link summary { cursor: pointer; color: var(--muted); font-size: 0.88rem; }
  .p-vid-link input { margin-top: 8px; }

  .p-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  .p-actions .p-msg { margin: 0 auto 0 0; }
  .p-btn {
    font: inherit; cursor: pointer; border: 1px solid var(--border); background: transparent; color: var(--text);
    border-radius: 9px; padding: 9px 18px;
  }
  .p-btn.primary { background: var(--text); color: var(--bg); border-color: var(--text); }
  .p-btn:disabled { opacity: 0.5; cursor: default; }
  .p-btn.danger { color: #e05a5a; }
  .p-link { font: inherit; background: none; border: 0; color: var(--muted); cursor: pointer; text-decoration: underline; padding: 0; }
  .p-msg { color: var(--muted); font-size: 0.9rem; }
  .p-msg.err { color: #e05a5a; }
  .p-msg.ok { color: var(--activity); }

  .p-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 18px; }
  .p-tab {
    font: inherit; font-weight: 600; background: none; border: 0; border-bottom: 2px solid transparent;
    color: var(--muted); padding: 8px 14px; margin-bottom: -1px; cursor: pointer;
  }
  .p-tab:hover { color: var(--text); }
  .p-tab[aria-selected='true'] { color: var(--text); border-bottom-color: var(--text); }
  .p-count { font-weight: 400; color: var(--muted); font-size: 0.85rem; }
  .p-comments { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .p-comment { border: 1px solid var(--border); border-radius: 11px; padding: 12px 14px; background: var(--surface); display: flex; gap: 12px; align-items: flex-start; }
  .p-comment-body { flex: 1; min-width: 0; }
  .p-comment-head { display: flex; gap: 10px; align-items: baseline; margin-bottom: 4px; }
  .p-comment-author { font-weight: 600; font-size: 0.95rem; }
  .p-comment-when { color: var(--muted); font-size: 0.78rem; }
  .p-comment-text { margin: 0; white-space: pre-wrap; word-break: break-word; line-height: 1.5; }
  .p-comment .p-btn { padding: 5px 12px; font-size: 0.85rem; flex-shrink: 0; }
  .p-comments .p-empty { color: var(--muted); }
  .p-select { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: 9px; padding: 10px 12px; }
  .p-areas { display: flex; gap: 8px; flex-wrap: wrap; }
  .p-area {
    --c: var(--muted);
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    border: 1.5px solid var(--border); border-radius: 999px; padding: 6px 14px; background: var(--bg);
    font-weight: 600; font-size: 0.9rem; color: var(--c);
  }
  .p-area.Creativity { --c: var(--creativity); }
  .p-area.Activity { --c: var(--activity); }
  .p-area.Service { --c: var(--service); }
  .p-area input { accent-color: var(--c); }
  .p-area:has(input:checked) { border-color: var(--c); background: color-mix(in srgb, var(--c) 14%, var(--bg)); }
  .p-list-title { font-size: 1.15rem; margin: 34px 0 10px; }
  .p-list { list-style: none; margin: 0; padding: 0; }
  .p-list li { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px solid var(--border); }
  .p-list .p-li-title { font-weight: 600; flex: 1 1 200px; color: var(--text); }
  .p-list .p-li-date { color: var(--muted); font-size: 0.85rem; }
  .p-list .p-btn { padding: 5px 12px; font-size: 0.85rem; }
  .p-list .p-empty { color: var(--muted); }
</style>

<script>
  import { getAuth, GoogleAuthProvider, onAuthStateChanged, signInWithPopup, signInWithRedirect, signOut, type User } from 'firebase/auth';
  import { ref, get, push, set, update, remove as dbRemove } from 'firebase/database';
  import {
    firebaseApp, db, emailKey, fetchPosts, fetchPost, fetchPhotos, fetchProject, parseLos, postUrl, fmtDate, chip, h, t,
    type LivePost, type LivePhoto, type Strand,
  } from '../lib/live';
  import { PEOPLE, getPerson } from '../people';
  import { AI_WORKER_URL } from '../ai-config';

  const MAX_PHOTOS = 60; // generous cap; photos are stored in the database, so keep it sane
  const MAX_PHOTO_CHARS = 1_300_000; // keep in sync with database.rules.json
  const WRITE_CHUNK = 8_000_000; // stay well under the Realtime Database single-write limit

  // Shrink a photo to a JPEG data URL small enough for the database.
  async function toJpeg(file: File): Promise<string> {
    let src: CanvasImageSource & { width: number; height: number };
    try {
      src = await createImageBitmap(file);
    } catch {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.src = url;
      await img.decode();
      URL.revokeObjectURL(url);
      src = img;
    }
    for (const [max, q] of [[1600, 0.82], [1600, 0.7], [1200, 0.7], [1000, 0.6]] as const) {
      const scale = Math.min(1, max / Math.max(src.width, src.height));
      const c = document.createElement('canvas');
      c.width = Math.round(src.width * scale);
      c.height = Math.round(src.height * scale);
      c.getContext('2d')!.drawImage(src, 0, 0, c.width, c.height);
      const data = c.toDataURL('image/jpeg', q);
      if (data.length <= MAX_PHOTO_CHARS) return data;
    }
    throw new Error('too big');
  }

  const today = () => {
    const d = new Date();
    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  };

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('.panel');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    const $ = <E extends HTMLElement>(id: string) => document.getElementById(id) as E;
    const signinBox = $('p-signin'), deniedBox = $('p-denied'), editor = $('p-editor');
    const form = $<HTMLFormElement>('p-form');
    const personSelect = $<HTMLSelectElement>('p-person-select');
    const photosEl = $('p-photos'), listEl = $('p-list'), msgEl = $('p-msg');
    const saveBtn = $<HTMLButtonElement>('p-save'), cancelBtn = $<HTMLButtonElement>('p-cancel');
    const field = <E extends HTMLInputElement | HTMLTextAreaElement>(name: string) => form.elements.namedItem(name) as E;

    const auth = getAuth(firebaseApp());
    let user: User | null = null;
    let person = ''; // slug being posted to
    let editing: LivePost | null = null;
    let photos: LivePhoto[] = [];
    let processing = 0;

    const show = (el: HTMLElement | null) => {
      for (const box of [signinBox, deniedBox, editor]) box.hidden = box !== el;
    };
    const say = (el: HTMLElement, en: string, pl: string, kind = '') => {
      el.className = 'p-msg ' + kind;
      el.replaceChildren(en ? t(en, pl) : '');
    };

    // Bilingual placeholders
    const applyPlaceholders = () => {
      const l = document.documentElement.dataset.lang === 'pl' ? 'pl' : 'en';
      root.querySelectorAll<HTMLElement>('[data-ph-en]').forEach((el) =>
        el.setAttribute('placeholder', el.dataset['ph' + (l === 'pl' ? 'Pl' : 'En')] ?? '')
      );
    };
    applyPlaceholders();
    document.addEventListener('langchange', applyPlaceholders);

    // ---- Auth -------------------------------------------------------------
    $('p-google').addEventListener('click', async () => {
      say($('p-signin-msg'), '', '');
      const provider = new GoogleAuthProvider();
      provider.setCustomParameters({ prompt: 'select_account' });
      try {
        await signInWithPopup(auth, provider);
      } catch (e: any) {
        if (e?.code === 'auth/popup-blocked') return signInWithRedirect(auth, provider);
        if (e?.code !== 'auth/popup-closed-by-user' && e?.code !== 'auth/cancelled-popup-request')
          say($('p-signin-msg'), `Sign-in failed (${e?.code ?? e}).`, `Logowanie nie powiodło się (${e?.code ?? e}).`, 'err');
      }
    });
    document.querySelectorAll('[data-signout]').forEach((b) => b.addEventListener('click', () => signOut(auth)));

    onAuthStateChanged(auth, async (u) => {
      user = u;
      if (!u?.email) return show(signinBox);
      let role: string | null = null;
      try {
        role = (await get(ref(db(), `editors/${emailKey(u.email)}`))).val();
      } catch {}
      if (role !== '*' && !getPerson(role ?? '')) {
        $('p-denied-email').textContent = u.email;
        return show(deniedBox);
      }
      $('p-email').textContent = u.email;
      const isAdmin = role === '*';
      personSelect.hidden = !isAdmin;
      $('p-person-name').hidden = isAdmin;
      setPerson(isAdmin ? personSelect.value || PEOPLE[0].slug : role!);
      show(editor);
    });

    personSelect.addEventListener('change', () => setPerson(personSelect.value));

    function setPerson(slug: string) {
      person = slug;
      personSelect.value = slug;
      $('p-person-name').textContent = getPerson(slug)?.name ?? slug;
      resetForm();
      loadList();
      loadComments();
      loadProject();
    }

    // ---- Tabs -------------------------------------------------------------
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.p-tab')];
    const showTab = (name: string) => {
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === name)));
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== name));
    };
    tabs.forEach((b) => b.addEventListener('click', () => showTab(b.dataset.tab!)));

    // ---- CAS project ------------------------------------------------------
    const projForm = $<HTMLFormElement>('p-proj-form');
    const projMsg = $('p-proj-msg');
    const projDel = $<HTMLButtonElement>('p-proj-delete');
    const pf = (name: string) => projForm.elements.namedItem(name) as HTMLInputElement;
    const PROJ_TEXT = ['title', 'duration', 'team', 'goal', 'how', 'outcomes', 'problems'];

    async function loadProject() {
      const forPerson = person;
      projForm.reset();
      say(projMsg, '', '');
      let plan = null;
      try {
        plan = await fetchProject(forPerson);
      } catch {}
      if (forPerson !== person) return;
      projDel.hidden = !plan;
      if (!plan) return;
      for (const k of PROJ_TEXT) pf(k).value = (plan as any)[k] ?? '';
      pf('status').value = plan.status ?? 'planning';
      const areas = (plan.areas ?? '').split(',');
      projForm.querySelectorAll<HTMLInputElement>('input[name="areas"]').forEach((c) => (c.checked = areas.includes(c.value)));
    }

    projForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!person) return;
      const title = pf('title').value.trim();
      if (!title) return say(projMsg, 'Add a project title.', 'Dodaj nazwę projektu.', 'err');
      const plan: Record<string, unknown> = { title, status: pf('status').value, updatedAt: Date.now() };
      for (const k of PROJ_TEXT.slice(1)) {
        const v = pf(k).value.trim();
        if (v) plan[k] = v;
      }
      const areas = [...projForm.querySelectorAll<HTMLInputElement>('input[name="areas"]:checked')].map((c) => c.value).join(',');
      if (areas) plan.areas = areas;
      say(projMsg, 'Saving…', 'Zapisywanie…');
      try {
        await set(ref(db(), `projects/${person}`), plan);
        projDel.hidden = false;
        const link = h('a');
        link.href = `${location.origin}${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${person}/project/`;
        link.append(t('View it →', 'Zobacz →'));
        say(projMsg, 'Saved! ', 'Zapisano! ', 'ok');
        projMsg.append(link);
      } catch (err: any) {
        say(projMsg, `Couldn't save (${err?.code ?? err}).`, `Nie udało się zapisać (${err?.code ?? err}).`, 'err');
      }
    });

    projDel.addEventListener('click', async () => {
      const q = document.documentElement.dataset.lang === 'pl' ? 'Usunąć plan projektu?' : 'Delete the project plan?';
      if (!confirm(q)) return;
      try {
        await dbRemove(ref(db(), `projects/${person}`));
        loadProject();
      } catch (err: any) {
        say(projMsg, `Couldn't delete (${err?.code ?? err}).`, `Nie udało się usunąć (${err?.code ?? err}).`, 'err');
      }
    });

    // ---- Comments ---------------------------------------------------------
    const commentsEl = $('p-comments');
    async function loadComments() {
      const forPerson = person;
      let items: { id: string; name?: string; text?: string; ts?: number }[] = [];
      try {
        const val = (await get(ref(db(), `comments/${forPerson}`))).val() ?? {};
        items = Object.entries(val).map(([id, c]: [string, any]) => ({ id, ...c }));
      } catch {}
      if (forPerson !== person) return;
      items.sort((a, b) => (b.ts ?? 0) - (a.ts ?? 0));
      $('p-c-count').textContent = items.length ? `(${items.length})` : '';
      if (!items.length) {
        const li = h('li', 'p-empty');
        li.append(t('No comments on this portfolio.', 'Brak komentarzy w tym portfolio.'));
        return commentsEl.replaceChildren(li);
      }
      const loc = () => (document.documentElement.dataset.lang === 'pl' ? 'pl-PL' : 'en-GB');
      commentsEl.replaceChildren(
        ...items.map((c) => {
          const li = h('li', 'p-comment');
          const body = h('div', 'p-comment-body');
          const head = h('div', 'p-comment-head');
          const author = h('span', 'p-comment-author');
          if (c.name?.trim()) author.textContent = c.name.trim();
          else author.append(t('Anonymous', 'Anonim'));
          const when = c.ts
            ? new Date(c.ts).toLocaleString(loc(), { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
            : '';
          head.append(author, h('span', 'p-comment-when', when));
          body.append(head, h('p', 'p-comment-text', String(c.text ?? '')));
          const del = h('button', 'p-btn danger');
          del.type = 'button';
          del.append(t('Delete', 'Usuń'));
          del.addEventListener('click', async () => {
            const q = document.documentElement.dataset.lang === 'pl' ? 'Usunąć ten komentarz?' : 'Delete this comment?';
            if (!confirm(q)) return;
            del.disabled = true;
            try {
              await dbRemove(ref(db(), `comments/${forPerson}/${c.id}`));
              loadComments();
            } catch (err: any) {
              del.disabled = false;
              alert(`Couldn't delete (${err?.code ?? err}).`);
            }
          });
          li.append(body, del);
          return li;
        })
      );
    }

    // ---- Form -------------------------------------------------------------
    function setMode(isEdit: boolean) {
      $('p-mode-new').hidden = isEdit;
      $('p-mode-edit').hidden = !isEdit;
      $('p-save-new').hidden = isEdit;
      $('p-save-edit').hidden = !isEdit;
      cancelBtn.hidden = !isEdit;
    }

    function resetForm() {
      form.reset();
      field('date').value = today();
      editing = null;
      photos = [];
      renderPhotos();
      resetVideoUI();
      setMode(false);
    }

    function renderPhotos() {
      photosEl.replaceChildren(
        ...photos.map((p, i) => {
          const box = h('div', 'p-photo');
          const img = h('img');
          img.src = p.src;
          img.alt = '';
          const cap = h('input');
          cap.maxLength = 200;
          cap.value = p.caption ?? '';
          cap.placeholder = document.documentElement.dataset.lang === 'pl' ? 'Podpis' : 'Caption';
          cap.addEventListener('input', () => (p.caption = cap.value));
          const x = h('button', 'p-x', '×');
          x.type = 'button';
          x.title = 'Remove';
          x.addEventListener('click', () => {
            photos.splice(i, 1);
            renderPhotos();
          });
          box.append(img, x, cap);
          return box;
        })
      );
    }

    async function addFiles(files: FileList | File[]) {
      const list = [...files].filter((f) => f.type.startsWith('image/'));
      const room = MAX_PHOTOS - photos.length - processing;
      if (list.length > room) say(msgEl, `Max ${MAX_PHOTOS} photos.`, `Maks. ${MAX_PHOTOS} zdjęć.`, 'err');
      for (const f of list.slice(0, Math.max(0, room))) {
        processing++;
        say(msgEl, 'Processing photos…', 'Przetwarzanie zdjęć…');
        try {
          photos.push({ src: await toJpeg(f), caption: '' });
          renderPhotos();
        } catch {
          say(msgEl, `Couldn't read "${f.name}".`, `Nie udało się wczytać „${f.name}".`, 'err');
        } finally {
          processing--;
        }
      }
      if (!processing && msgEl.textContent?.startsWith('Processing')) say(msgEl, '', '');
    }

    const filesInput = $<HTMLInputElement>('p-files');
    filesInput.addEventListener('change', () => {
      if (filesInput.files) addFiles(filesInput.files);
      filesInput.value = '';
    });
    const drop = $('p-drop');
    drop.addEventListener('dragover', (e) => {
      e.preventDefault();
      drop.classList.add('over');
    });
    drop.addEventListener('dragleave', () => drop.classList.remove('over'));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      drop.classList.remove('over');
      if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
    });

    cancelBtn.addEventListener('click', resetForm);

    // ---- Video upload (to the Cloudflare Worker + R2) ---------------------
    const vidDrop = $('p-vid-drop'), vidFile = $<HTMLInputElement>('p-vid-file');
    const vidMsg = $('p-vid-msg'), vidProg = $('p-vid-progress'), vidBar = $('p-vid-bar');
    const vidCurrent = $('p-vid-current'), vidName = $('p-vid-name');
    const workerBase = AI_WORKER_URL ? AI_WORKER_URL.replace(/\/$/, '') : null;
    const isUploaded = (u: string) => !!workerBase && u.startsWith(workerBase + '/v/');

    function showVideoState() {
      const v = field('video').value.trim();
      const uploaded = !!v && isUploaded(v);
      vidCurrent.hidden = !uploaded;
      if (uploaded) vidName.textContent = v.split('/').pop() || v;
      const linkBox = form.querySelector<HTMLDetailsElement>('.p-vid-link');
      if (linkBox) linkBox.open = !!v && !uploaded;
    }
    function resetVideoUI() {
      vidProg.hidden = true;
      vidBar.style.width = '0%';
      say(vidMsg, '', '');
      showVideoState();
    }

    if (workerBase) {
      vidDrop.hidden = false;
      const uploadVideo = async (file: File) => {
        if (!user) return;
        if (!/^video\/(mp4|webm|ogg|quicktime)$/.test(file.type))
          return say(vidMsg, 'Use an MP4, WebM, OGG or MOV file.', 'Użyj pliku MP4, WebM, OGG lub MOV.', 'err');
        if (file.size > 100 * 1024 * 1024)
          return say(vidMsg, 'That video is over 100 MB. Trim or compress it first.', 'To wideo przekracza 100 MB. Najpierw je przytnij lub skompresuj.', 'err');
        let token: string;
        try { token = await user.getIdToken(); } catch { return say(vidMsg, 'Please sign in again.', 'Zaloguj się ponownie.', 'err'); }
        vidProg.hidden = false;
        vidBar.style.width = '0%';
        say(vidMsg, 'Uploading…', 'Wysyłanie…');
        await new Promise<void>((resolve) => {
          const xhr = new XMLHttpRequest();
          xhr.open('POST', workerBase + '/upload');
          xhr.setRequestHeader('Authorization', `Bearer ${token}`);
          xhr.setRequestHeader('Content-Type', file.type);
          xhr.upload.addEventListener('progress', (ev) => {
            if (ev.lengthComputable) vidBar.style.width = `${Math.round((ev.loaded / ev.total) * 100)}%`;
          });
          xhr.addEventListener('load', () => {
            vidProg.hidden = true;
            let data: any = {};
            try { data = JSON.parse(xhr.responseText); } catch {}
            if (xhr.status === 200 && data.url) {
              field('video').value = data.url;
              say(vidMsg, 'Video uploaded.', 'Wideo wysłane.', 'ok');
              showVideoState();
            } else {
              say(vidMsg, `Upload failed (${data.error || 'HTTP ' + xhr.status}).`, `Nie udało się wysłać (${data.error || 'HTTP ' + xhr.status}).`, 'err');
            }
            resolve();
          });
          xhr.addEventListener('error', () => {
            vidProg.hidden = true;
            say(vidMsg, 'Upload failed (network).', 'Nie udało się wysłać (sieć).', 'err');
            resolve();
          });
          xhr.send(file);
        });
      };
      vidFile.addEventListener('change', () => {
        if (vidFile.files?.[0]) uploadVideo(vidFile.files[0]);
        vidFile.value = '';
      });
      vidDrop.addEventListener('dragover', (e) => { e.preventDefault(); vidDrop.classList.add('over'); });
      vidDrop.addEventListener('dragleave', () => vidDrop.classList.remove('over'));
      vidDrop.addEventListener('drop', (e) => {
        e.preventDefault();
        vidDrop.classList.remove('over');
        const f = (e as DragEvent).dataTransfer?.files?.[0];
        if (f) uploadVideo(f);
      });
    }
    $('p-vid-clear').addEventListener('click', () => {
      field('video').value = '';
      resetVideoUI();
    });

    // ---- Write with AI ----------------------------------------------------
    const aiBtn = $<HTMLButtonElement>('p-ai');
    const aiMsg = $('p-ai-msg');
    if (AI_WORKER_URL) {
      aiBtn.hidden = false;
      $('p-ai-note').hidden = false;
      aiBtn.addEventListener('click', async () => {
        const lang = document.documentElement.dataset.lang === 'pl' ? 'pl' : 'en';
        const strand = form.querySelector<HTMLInputElement>('input[name="strand"]:checked')?.value ?? '';
        const title = field('title').value.trim();
        if (!strand || !title) return say(aiMsg, 'Pick a strand and add a title first.', 'Najpierw wybierz obszar i dodaj tytuł.', 'err');
        const reflEl = field('reflection') as HTMLTextAreaElement;
        if (reflEl.value.trim()) {
          const q = lang === 'pl' ? 'Zastąpić obecny tekst refleksji?' : 'Replace the current reflection text?';
          if (!confirm(q)) return;
        }
        const los = [...form.querySelectorAll<HTMLInputElement>('input[name="lo"]:checked')].map((c) => Number(c.value));
        const captions = photos.map((p) => p.caption?.trim()).filter(Boolean) as string[];
        aiBtn.disabled = true;
        const payload = JSON.stringify({ title, strand, summary: field('summary').value.trim(), hours: Number(field('hours').value) || 0, lang, los, captions });
        // The model can be briefly busy (HTTP 503), so retry a few times.
        const ATTEMPTS = 4;
        try {
          let lastErr = '';
          for (let i = 0; i < ATTEMPTS; i++) {
            say(aiMsg, i ? `Model is busy, retrying… (${i + 1}/${ATTEMPTS})` : 'Writing…', i ? `Model zajęty, ponawiam… (${i + 1}/${ATTEMPTS})` : 'Piszę…');
            const res = await fetch(AI_WORKER_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.text) {
              reflEl.value = data.text;
              reflEl.dispatchEvent(new Event('input'));
              say(aiMsg, 'Draft added. Read it and make it your own.', 'Dodano szkic. Przeczytaj go i napisz po swojemu.', 'ok');
              return;
            }
            lastErr = data.error || `HTTP ${res.status}`;
            const busy = res.status === 502 || res.status === 503 || /503|UNAVAILABLE|high demand/i.test(JSON.stringify(data));
            if (!busy) break;
            await new Promise((r) => setTimeout(r, 1500 * (i + 1)));
          }
          say(aiMsg, `AI couldn't write this (${lastErr}). Try again.`, `AI nie zdołało napisać (${lastErr}). Spróbuj ponownie.`, 'err');
        } catch (err: any) {
          say(aiMsg, `AI couldn't write this (${err?.message ?? err}).`, `AI nie zdołało napisać (${err?.message ?? err}).`, 'err');
        } finally {
          aiBtn.disabled = false;
        }
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!user?.email || !person) return;
      const strand = (form.querySelector<HTMLInputElement>('input[name="strand"]:checked')?.value ?? '') as Strand;
      const title = field('title').value.trim();
      const date = field('date').value;
      if (!strand) return say(msgEl, 'Pick Creativity, Activity, Service or Project.', 'Wybierz Kreatywność, Aktywność, Służbę albo Projekt.', 'err');
      if (!title) return say(msgEl, 'Add a title.', 'Dodaj tytuł.', 'err');
      if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return say(msgEl, 'Pick a date.', 'Wybierz datę.', 'err');
      if (processing) return say(msgEl, 'Wait for the photos to finish.', 'Poczekaj, aż zdjęcia się przetworzą.', 'err');

      const los = [...form.querySelectorAll<HTMLInputElement>('input[name="lo"]:checked')].map((c) => c.value).join(',');
      const hoursRaw = field('hours').value;
      const now = Date.now();
      const post: Record<string, unknown> = {
        title,
        strand,
        date,
        los,
        photoCount: photos.length,
        createdAt: editing?.createdAt ?? now,
        updatedAt: now,
      };
      const summary = field('summary').value.trim();
      const reflection = field('reflection').value.trim();
      const video = field('video').value.trim();
      if (summary) post.summary = summary;
      if (reflection) post.reflection = reflection;
      if (video) post.video = video.slice(0, 400);
      if (hoursRaw !== '' && Number(hoursRaw) >= 0) post.hours = Number(hoursRaw);

      const id = editing?.id ?? push(ref(db(), `posts/${person}`)).key!;
      const photoData = photos.map((p) =>
        p.caption?.trim() ? { src: p.src, caption: p.caption.trim().slice(0, 200) } : { src: p.src }
      );

      saveBtn.disabled = true;
      say(msgEl, 'Saving…', 'Zapisywanie…');
      try {
        // Write the post and clear old photos, then upload photos in size-bounded
        // chunks so no single write exceeds the Realtime Database limit.
        await update(ref(db()), { [`posts/${person}/${id}`]: post, [`photos/${person}/${id}`]: null });
        let batch: Record<string, unknown> = {};
        let bytes = 0;
        const flush = async () => {
          if (!Object.keys(batch).length) return;
          await update(ref(db(), `photos/${person}/${id}`), batch);
          batch = {};
          bytes = 0;
        };
        for (let i = 0; i < photoData.length; i++) {
          const size = photoData[i].src.length + (photoData[i].caption?.length ?? 0);
          if (bytes + size > WRITE_CHUNK) await flush();
          batch[i] = photoData[i];
          bytes += size;
        }
        await flush();
        const link = h('a', undefined);
        link.href = postUrl(person, id);
        link.append(t('View it →', 'Zobacz →'));
        say(msgEl, 'Saved! ', 'Zapisano! ', 'ok');
        msgEl.append(link);
        resetForm();
        loadList();
      } catch (err: any) {
        say(msgEl, `Couldn't save (${err?.code ?? err}).`, `Nie udało się zapisać (${err?.code ?? err}).`, 'err');
      } finally {
        saveBtn.disabled = false;
      }
    });

    async function startEdit(id: string) {
      say(msgEl, 'Loading…', 'Ładowanie…');
      const post = await fetchPost(person, id);
      if (!post) return say(msgEl, 'Entry not found.', 'Nie znaleziono wpisu.', 'err');
      resetForm();
      editing = post;
      form.querySelector<HTMLInputElement>(`input[name="strand"][value="${post.strand}"]`)!.checked = true;
      field('title').value = post.title;
      field('date').value = post.date;
      field('summary').value = post.summary ?? '';
      field('reflection').value = post.reflection ?? '';
      field('video').value = post.video ?? '';
      showVideoState();
      field('hours').value = post.hours != null ? String(post.hours) : '';
      const los = parseLos(post.los);
      form.querySelectorAll<HTMLInputElement>('input[name="lo"]').forEach((c) => (c.checked = los.includes(Number(c.value))));
      photos = post.photoCount ? await fetchPhotos(person, id) : [];
      renderPhotos();
      setMode(true);
      say(msgEl, '', '');
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function remove(p: LivePost) {
      const q = document.documentElement.dataset.lang === 'pl' ? `Usunąć „${p.title}"?` : `Delete "${p.title}"?`;
      if (!confirm(q)) return;
      try {
        await update(ref(db()), { [`posts/${person}/${p.id}`]: null, [`photos/${person}/${p.id}`]: null });
        if (editing?.id === p.id) resetForm();
        loadList();
      } catch (err: any) {
        alert(`Couldn't delete (${err?.code ?? err}).`);
      }
    }

    async function loadList() {
      const forPerson = person;
      let posts: LivePost[] = [];
      try {
        posts = await fetchPosts(forPerson);
      } catch {}
      if (forPerson !== person) return; // switched person meanwhile
      posts.sort((a, b) => (b.date + b.createdAt).localeCompare(a.date + a.createdAt));
      if (!posts.length) {
        const li = h('li', 'p-empty');
        li.append(t('Nothing yet. Your entries will show up here.', 'Jeszcze nic. Tu pojawią się twoje wpisy.'));
        return listEl.replaceChildren(li);
      }
      listEl.replaceChildren(
        ...posts.map((p) => {
          const li = h('li');
          const view = h('a', 'p-btn');
          view.href = postUrl(p.person, p.id);
          view.append(t('View', 'Zobacz'));
          const edit = h('button', 'p-btn');
          edit.type = 'button';
          edit.append(t('Edit', 'Edytuj'));
          edit.addEventListener('click', () => startEdit(p.id));
          const del = h('button', 'p-btn danger');
          del.type = 'button';
          del.append(t('Delete', 'Usuń'));
          del.addEventListener('click', () => remove(p));
          li.append(chip(p.strand), h('span', 'p-li-title', p.title), h('span', 'p-li-date', fmtDate(p.date)), view, edit, del);
          return li;
        })
      );
    }
  });
</script>
