---
import { getCollection, render } from 'astro:content';
import { LEARNING_OUTCOMES } from '../../../content.config';
import { getPerson } from '../../../people';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppleFitness from '../../../components/AppleFitness.astro';
import Evidence from '../../../components/Evidence.astro';

export async function getStaticPaths() {
  const posts = await getCollection('reflections', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { person: post.data.person, slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const person = getPerson(post.data.person);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const los = post.data.learningOutcomes.sort((a, b) => a - b);
---

<BaseLayout title={`${post.data.title} · CAS`} description={post.data.summary} person={person}>
  <article class="article wrap">
    <a class="back-link" href={`${base}${post.data.person}/`}>&larr; {person?.name ?? 'Home'}</a>

    <header class="article-header">
      <div class="post-meta">
        {post.data.strands.map((s) => (
          <span class={`chip ${s}`}>{s}</span>
        ))}
        <span class="post-date">{fmtDate(post.data.date)}</span>
        {post.data.hours ? <span class="post-date">· {post.data.hours} h</span> : null}
      </div>
      <h1>{post.data.title}</h1>
    </header>

    {post.data.image && (
      <img class="article-cover" src={post.data.image.startsWith('http') ? post.data.image : base + post.data.image.replace(/^\//, '')} alt={post.data.title} />
    )}

    {post.data.fitness && (
      <AppleFitness
        activity={post.data.fitness.activity}
        rings={post.data.fitness.rings}
        workouts={post.data.fitness.workouts}
      />
    )}

    <div class="prose">
      <Content />
    </div>

    <Evidence gallery={post.data.gallery} attachments={post.data.attachments} />

    {los.length > 0 && (
      <div class="lo-callout">
        <h3>Related Learning Outcomes</h3>
        <ul>
          {los.map((n) => (
            <li><span class="n">LO{n}</span><span>{LEARNING_OUTCOMES[n]}</span></li>
          ))}
        </ul>
      </div>
    )}
  </article>
</BaseLayout>
