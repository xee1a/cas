---
import { getCollection } from 'astro:content';
import { STRANDS } from '../../../content.config';
import { PEOPLE } from '../../../people';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import T from '../../../components/T.astro';
import { STRAND_PL } from '../../../i18n';

export async function getStaticPaths() {
  return PEOPLE.map((person) => ({ params: { person: person.slug }, props: { person } }));
}

const { person } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (
  await getCollection('reflections', ({ data }) => !data.draft && data.person === person.slug)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`All experiences · ${person.name}`} person={person}>
  <section class="wrap listing">
    <a class="back-link" href={`${base}${person.slug}/`}>&larr; {person.name}</a>
    <h1 class="listing-title"><T en="All experiences" pl="Wszystkie doświadczenia" /></h1>

    <div class="filters">
      <button class="filter-btn active" data-strand="all"><T en="All" pl="Wszystkie" /></button>
      {STRANDS.map((s) => (
        <button class="filter-btn" data-strand={s}><T en={s} pl={STRAND_PL[s]} /></button>
      ))}
    </div>

    <PostList posts={posts} person={person.slug} />
  </section>
</BaseLayout>

<script>
  // Re-run on every view-transition navigation; re-filter when live entries arrive.
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    if (!buttons.length) return;
    let strand = 'all';
    const apply = () => {
      document.querySelectorAll<HTMLLIElement>('.post-item').forEach((item) => {
        const strands = (item.dataset.strands ?? '').split(',');
        item.style.display = strand === 'all' || strands.includes(strand) ? '' : 'none';
      });
    };
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        strand = btn.dataset.strand!;
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        apply();
      });
    });
    document.querySelector('ul[data-live-person]')?.addEventListener('live-posts', apply);
  });
</script>
