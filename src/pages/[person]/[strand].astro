---
import { getCollection } from 'astro:content';
import { STRANDS } from '../../content.config';
import { PEOPLE } from '../../people';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import T from '../../components/T.astro';
import { STRAND_PL, STRAND_SUB_PL, STRAND_SUB_EN } from '../../i18n';

export async function getStaticPaths() {
  return PEOPLE.flatMap((person) =>
    STRANDS.map((s) => ({
      params: { person: person.slug, strand: s.toLowerCase() },
      props: { person, strand: s },
    }))
  );
}

const { person, strand } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const posts = (
  await getCollection(
    'reflections',
    ({ data }) => !data.draft && data.person === person.slug && data.strands.includes(strand as any)
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

---

<BaseLayout title={`${strand} · ${person.name}`} person={person}>
  <section class={`strand-page wrap ${strand}`}>
    <a class="back-link" href={`${base}${person.slug}/`}>&larr; {person.name}</a>
    <header class="strand-header">
      <span class={`chip ${strand}`}><T en={strand} pl={STRAND_PL[strand]} /></span>
      <h1><T en={strand} pl={STRAND_PL[strand]} /></h1>
      <p><T en={STRAND_SUB_EN[strand]} pl={STRAND_SUB_PL[strand]} /></p>
    </header>
    <PostList posts={posts} person={person.slug} strand={strand} />
  </section>
</BaseLayout>
