---
import { getCollection } from 'astro:content';
import { STRANDS } from '../../content.config';
import { PEOPLE, getPerson } from '../../people';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  return PEOPLE.map((person) => ({ params: { person: person.slug }, props: { person } }));
}

const { person } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const photoSrc = person.photo
  ? person.photo.startsWith('http')
    ? person.photo
    : base + person.photo.replace(/^\//, '')
  : '';

const posts = await getCollection(
  'reflections',
  ({ data }) => !data.draft && data.person === person.slug
);
const covered = new Set(posts.flatMap((p) => p.data.learningOutcomes)).size;

const CAPTION: Record<string, string> = {
  Creativity: 'Art, projects, making',
  Activity: 'Sport, movement, effort',
  Service: 'Volunteering, helping others',
};
---

<BaseLayout title={`${person.name} · CAS Portfolio`} description={person.intro} person={person}>
  <section class="home wrap">
    <a class="back-link" href={base}>&larr; All portfolios</a>
    <header class="profile">
      {photoSrc && <img class="profile-photo" src={photoSrc} alt={person.name} />}
      <h1>{person.name}</h1>
      <p class="tagline">{person.tagline}</p>
      <p class="lede">{person.intro}</p>
    </header>

    <nav class="strand-list" aria-label="CAS strands">
      {STRANDS.map((s) => (
        <a class={`strand-row ${s}`} href={`${base}${person.slug}/${s.toLowerCase()}/`}>
          <span class="strand-mark" aria-hidden="true"></span>
          <span class="strand-body">
            <span class="strand-name">{s}</span>
            <span class="strand-sub">{CAPTION[s]}</span>
          </span>
        </a>
      ))}
    </nav>

    <nav class="home-links">
      <a href={`${base}${person.slug}/reflections/`}>All experiences</a>
      <span aria-hidden="true">·</span>
      <a href={`${base}${person.slug}/progress/`}>Learning outcomes {covered}/7</a>
    </nav>

    <Comments slug={person.slug} name={person.name} />
  </section>
</BaseLayout>
