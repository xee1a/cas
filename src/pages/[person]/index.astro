---
import { getCollection } from 'astro:content';
import { STRANDS } from '../../content.config';
import { PEOPLE, getPerson } from '../../people';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import T from '../../components/T.astro';
import { STRAND_PL, STRAND_SUB_PL, STRAND_SUB_EN } from '../../i18n';

export async function getStaticPaths() {
  return PEOPLE.map((person) => ({ params: { person: person.slug }, props: { person } }));
}

const { person } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const photoSrc = person.photo
  ? person.photo.startsWith('http')
    ? person.photo
    : base + person.photo.replace(/^\//, '')
  : '';

const posts = await getCollection(
  'reflections',
  ({ data }) => !data.draft && data.person === person.slug
);
const covered = new Set(posts.flatMap((p) => p.data.learningOutcomes)).size;

---

<BaseLayout title={`${person.name} · CAS Portfolio`} description={person.intro} person={person}>
  <section class="home wrap">
    <a class="back-link" href={base}>&larr; <T en="All portfolios" pl="Wszystkie portfolia" /></a>
    <header class="profile">
      {photoSrc && <img class="profile-photo" src={photoSrc} alt={person.name} />}
      <h1>{person.name}</h1>
      <p class="tagline"><T en={person.tagline} pl={person.taglinePl} /></p>
      <p class="lede"><T en={person.intro} pl={person.introPl} /></p>
    </header>

    <nav class="strand-list" aria-label="CAS strands">
      {STRANDS.map((s) => (
        <a class={`strand-row ${s}`} href={`${base}${person.slug}/${s.toLowerCase()}/`}>
          <span class="strand-mark" aria-hidden="true"></span>
          <span class="strand-body">
            <span class="strand-name"><T en={s} pl={STRAND_PL[s]} /></span>
            <span class="strand-sub"><T en={STRAND_SUB_EN[s]} pl={STRAND_SUB_PL[s]} /></span>
          </span>
        </a>
      ))}
    </nav>

    <nav class="home-links">
      <a href={`${base}${person.slug}/reflections/`}><T en="All experiences" pl="Wszystkie doświadczenia" /></a>
      <span aria-hidden="true">·</span>
      <a href={`${base}${person.slug}/progress/`}><T en="Learning outcomes" pl="Efekty uczenia się" /> {covered}/7</a>
    </nav>

    <Comments slug={person.slug} name={person.name} />
  </section>
</BaseLayout>
