---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIREBASE_CONFIG } from '../four-chess-config';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Four-Player Chess">
  <section class="fpc-wrap">
    <p class="fpc-back"><a href={base}>&larr; Back to portfolios</a></p>
    <h1 class="fpc-title">Four-Player Chess</h1>
    <p class="fpc-lede">A hidden corner of the portfolio. Four players queue up, then play.</p>

    <div id="fpc-status" class="fpc-statusbar" aria-live="polite"></div>
    <div id="fpc-lobby" class="fpc-lobby" hidden></div>
    <div id="fpc-board-outer" class="fpc-board-outer" hidden>
      <div id="fpc-board" class="fpc-board"></div>
    </div>
    <div class="fpc-controls">
      <button id="fpc-reset" class="fpc-btn" type="button">New table</button>
      <span id="fpc-mode" class="fpc-mode"></span>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .fpc-wrap { max-width: 760px; margin: 0 auto; padding: 40px 20px 80px; }
  .fpc-back a { color: var(--muted); text-decoration: none; font-size: 0.9rem; }
  .fpc-title { font-family: var(--serif); font-size: 2.4rem; margin: 14px 0 6px; letter-spacing: -0.02em; }
  .fpc-lede { color: var(--muted); margin: 0 0 22px; }
  .fpc-statusbar { font-size: 0.98rem; margin-bottom: 18px; min-height: 1.4em; }
  .fpc-statusbar .turn-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 7px; vertical-align: middle; }

  .fpc-lobby { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 8px; }
  [hidden] { display: none !important; }
  .seat { border: 1px solid var(--border); border-radius: 12px; padding: 16px; display: flex; align-items: center; gap: 12px; background: var(--surface); }
  .seat .chip { width: 16px; height: 16px; border-radius: 50%; flex: none; }
  .seat .who { flex: 1; }
  .seat .who b { display: block; font-size: 1rem; }
  .seat .who small { color: var(--muted); }
  .seat button { border: 1px solid var(--border); background: transparent; color: var(--text); border-radius: 8px; padding: 7px 12px; cursor: pointer; font-size: 0.9rem; }
  .seat button:hover { border-color: var(--text); }
  .seat.mine { border-color: var(--text); }

  .fpc-board-outer { overflow: auto; margin: 6px 0 18px; }
  .fpc-board {
    display: grid;
    grid-template-columns: repeat(14, 1fr);
    width: min(100%, 700px, 78vh);
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    border: 1px solid var(--border);
    background: var(--border);
    gap: 1px;
    user-select: none;
  }
  .cell { position: relative; display: flex; align-items: center; justify-content: center; font-size: clamp(13px, 3.4vw, 30px); line-height: 1; cursor: default; }
  .cell.void { background: transparent; visibility: hidden; }
  .cell.lightsq { background: #ece6da; }
  .cell.darksq { background: #cdbfa6; }
  .cell.sel { outline: 3px solid #2b7; outline-offset: -3px; z-index: 2; }
  .cell.move::after { content: ''; position: absolute; width: 26%; height: 26%; border-radius: 50%; background: rgba(20,120,60,0.55); }
  .cell.capture::after { content: ''; position: absolute; inset: 8%; border-radius: 50%; border: 3px solid rgba(200,40,40,0.7); }
  .cell.check { outline: 3px solid #e33; outline-offset: -3px; }
  .cell .pc { pointer-events: none; }
  .pc.R { color: #d23b3b; } .pc.B { color: #2f6fd6; } .pc.Y { color: #c99a00; } .pc.G { color: #2e9e3f; }
  .pc.dead { color: #8a8a8a; opacity: 0.55; }
  .cell.playable { cursor: pointer; }

  .fpc-controls { display: flex; align-items: center; gap: 14px; }
  .fpc-btn { border: 1px solid var(--border); background: transparent; color: var(--text); border-radius: 8px; padding: 8px 14px; cursor: pointer; }
  .fpc-btn:hover { border-color: var(--text); }
  .fpc-mode { color: var(--muted); font-size: 0.85rem; }
  @media (max-width: 520px) { .fpc-lobby { grid-template-columns: 1fr; } }
</style>

<script is:inline define:vars={{ FIREBASE_CONFIG, base }}>
  // ===================== 4-Player Chess =====================
  const COLORS = ['R', 'B', 'Y', 'G'];
  const COLOR_NAME = { R: 'Red', B: 'Blue', Y: 'Yellow', G: 'Green' };
  const COLOR_HEX = { R: '#d23b3b', B: '#2f6fd6', Y: '#c99a00', G: '#2e9e3f' };
  const GLYPH = { K: '♚', Q: '♛', R: '♜', B: '♝', N: '♞', P: '♟' };

  // Board geometry: 14x14 with the four 3x3 corners removed.
  const off = (r, c) =>
    r < 0 || r > 13 || c < 0 || c > 13 || ((r < 3 || r > 10) && (c < 3 || c > 10));

  // Pawn behaviour per army: forward vector, capture diagonals, promotion line.
  const PAWN = {
    R: { fwd: [-1, 0], caps: [[-1, -1], [-1, 1]], promo: (r) => r === 3 },
    B: { fwd: [0, 1], caps: [[-1, 1], [1, 1]], promo: (_, c) => c === 10 },
    Y: { fwd: [1, 0], caps: [[1, -1], [1, 1]], promo: (r) => r === 10 },
    G: { fwd: [0, -1], caps: [[-1, -1], [1, -1]], promo: (_, c) => c === 3 },
  };
  const ORTH = [[1, 0], [-1, 0], [0, 1], [0, -1]];
  const DIAG = [[1, 1], [1, -1], [-1, 1], [-1, -1]];
  const KNIGHT = [[1, 2], [2, 1], [-1, 2], [-2, 1], [1, -2], [2, -1], [-1, -2], [-2, -1]];

  function initBoard() {
    const b = Array.from({ length: 14 }, () => Array(14).fill(null));
    const back = ['R', 'N', 'B', 'K', 'Q', 'B', 'N', 'R'];
    const backKQswap = ['R', 'N', 'B', 'Q', 'K', 'B', 'N', 'R']; // yellow/green: king & queen mirrored
    for (let i = 0; i < 8; i++) {
      const col = 3 + i;
      b[13][col] = { c: 'R', t: back[i] };
      b[12][col] = { c: 'R', t: 'P' };
      b[0][col] = { c: 'Y', t: backKQswap[i] };
      b[1][col] = { c: 'Y', t: 'P' };
      const row = 3 + i;
      b[row][0] = { c: 'B', t: back[i] };
      b[row][1] = { c: 'B', t: 'P' };
      b[row][13] = { c: 'G', t: backKQswap[i] };
      b[row][12] = { c: 'G', t: 'P' };
    }
    return b;
  }

  const cloneBoard = (b) => b.map((row) => row.map((c) => (c ? { ...c } : null)));

  // Pseudo-legal target squares for the piece at (r,c). Kings are never capturable.
  function pseudo(b, r, c) {
    const p = b[r][c];
    if (!p) return [];
    const out = [];
    const enemyOpen = (tr, tc) => {
      if (off(tr, tc)) return false;
      const q = b[tr][tc];
      if (!q) return true;
      return q.c !== p.c && q.t !== 'K';
    };
    const slide = (dirs) => {
      for (const [dr, dc] of dirs) {
        let tr = r + dr, tc = c + dc;
        while (!off(tr, tc)) {
          const q = b[tr][tc];
          if (!q) { out.push([tr, tc]); }
          else { if (q.c !== p.c && q.t !== 'K') out.push([tr, tc]); break; }
          tr += dr; tc += dc;
        }
      }
    };
    if (p.t === 'N') { for (const [dr, dc] of KNIGHT) if (enemyOpen(r + dr, c + dc)) out.push([r + dr, c + dc]); }
    else if (p.t === 'K') { for (const [dr, dc] of [...ORTH, ...DIAG]) if (enemyOpen(r + dr, c + dc)) out.push([r + dr, c + dc]); }
    else if (p.t === 'R') slide(ORTH);
    else if (p.t === 'B') slide(DIAG);
    else if (p.t === 'Q') slide([...ORTH, ...DIAG]);
    else if (p.t === 'P') {
      const cfg = PAWN[p.c];
      const f1r = r + cfg.fwd[0], f1c = c + cfg.fwd[1];
      if (!off(f1r, f1c) && !b[f1r][f1c]) {
        out.push([f1r, f1c]);
        const f2r = r + cfg.fwd[0] * 2, f2c = c + cfg.fwd[1] * 2;
        if (!p.moved && !off(f2r, f2c) && !b[f2r][f2c]) out.push([f2r, f2c]);
      }
      for (const [dr, dc] of cfg.caps) {
        const tr = r + dr, tc = c + dc;
        if (off(tr, tc)) continue;
        const q = b[tr][tc];
        if (q && q.c !== p.c && q.t !== 'K') out.push([tr, tc]);
      }
    }
    return out;
  }

  function kingPos(b, color) {
    for (let r = 0; r < 14; r++) for (let c = 0; c < 14; c++) {
      const p = b[r][c];
      if (p && p.c === color && p.t === 'K') return [r, c];
    }
    return null;
  }

  // Is (r,c) attacked by any alive army other than victimColor?
  function attacked(b, alive, r, c, victimColor) {
    // knights
    for (const [dr, dc] of KNIGHT) {
      const q = b[r + dr] && b[r + dr][c + dc];
      if (q && q.t === 'N' && q.c !== victimColor && alive[q.c]) return true;
    }
    // orth (rook/queen) + adjacent king
    for (const [dr, dc] of ORTH) {
      let tr = r + dr, tc = c + dc, step = 0;
      while (!off(tr, tc)) {
        const q = b[tr][tc];
        if (q) {
          if (q.c !== victimColor && alive[q.c] && (q.t === 'R' || q.t === 'Q' || (step === 0 && q.t === 'K'))) return true;
          break;
        }
        tr += dr; tc += dc; step++;
      }
    }
    // diag (bishop/queen) + adjacent king
    for (const [dr, dc] of DIAG) {
      let tr = r + dr, tc = c + dc, step = 0;
      while (!off(tr, tc)) {
        const q = b[tr][tc];
        if (q) {
          if (q.c !== victimColor && alive[q.c] && (q.t === 'B' || q.t === 'Q' || (step === 0 && q.t === 'K'))) return true;
          break;
        }
        tr += dr; tc += dc; step++;
      }
    }
    // pawns: an enemy pawn of color E attacks (r,c) if it sits at (r,c) minus one of E's capture vectors
    for (const E of COLORS) {
      if (E === victimColor || !alive[E]) continue;
      for (const [dr, dc] of PAWN[E].caps) {
        const sr = r - dr, sc = c - dc;
        if (off(sr, sc)) continue;
        const q = b[sr][sc];
        if (q && q.c === E && q.t === 'P') return true;
      }
    }
    return false;
  }

  const inCheck = (b, alive, color) => {
    const k = kingPos(b, color);
    return k ? attacked(b, alive, k[0], k[1], color) : false;
  };

  // Apply a move on a cloned board (auto-queen on promotion). Returns the clone.
  function applyMove(b, fr, fc, tr, tc) {
    const nb = cloneBoard(b);
    const p = nb[fr][fc];
    nb[fr][fc] = null;
    p.moved = true;
    if (p.t === 'P' && PAWN[p.c].promo(tr, tc)) p.t = 'Q';
    nb[tr][tc] = p;
    return nb;
  }

  function legalFrom(b, alive, r, c) {
    const p = b[r][c];
    if (!p) return [];
    return pseudo(b, r, c).filter(([tr, tc]) => {
      const nb = applyMove(b, r, c, tr, tc);
      return !inCheck(nb, alive, p.c);
    });
  }

  function hasAnyLegal(b, alive, color) {
    for (let r = 0; r < 14; r++) for (let c = 0; c < 14; c++) {
      const p = b[r][c];
      if (p && p.c === color && legalFrom(b, alive, r, c).length) return true;
    }
    return false;
  }

  const aliveCount = (alive) => COLORS.filter((c) => alive[c]).length;
  function nextAlive(alive, color) {
    let i = COLORS.indexOf(color);
    for (let n = 0; n < 4; n++) { i = (i + 1) % 4; if (alive[COLORS[i]]) return COLORS[i]; }
    return color;
  }

  // Remove a checkmated/stalemated army: king off, remaining pieces go inert (dead).
  function eliminate(b, alive, color) {
    alive[color] = false;
    for (let r = 0; r < 14; r++) for (let c = 0; c < 14; c++) {
      const p = b[r][c];
      if (p && p.c === color && p.t === 'K') b[r][c] = null;
    }
  }

  // ===================== State + transport =====================
  // Per-tab identity (sessionStorage is per browsing context), so two tabs or two
  // devices are two distinct players, while a reload keeps the same seat.
  const CLIENT_ID = (() => {
    try {
      let id = sessionStorage.getItem('fpc_client');
      if (!id) { id = Math.random().toString(36).slice(2); sessionStorage.setItem('fpc_client', id); }
      return id;
    } catch (e) { return Math.random().toString(36).slice(2); }
  })();

  let state = null;
  let net = null;
  let sel = null; // [r,c] currently selected

  function freshLobby() {
    return { status: 'lobby', seats: { R: null, B: null, Y: null, G: null }, board: null, turn: null, alive: null, winner: null, note: '' };
  }

  function localNet() {
    const KEY = 'fpc_state_v1';
    const bc = 'BroadcastChannel' in window ? new BroadcastChannel('fpc_v1') : null;
    const listeners = [];
    const read = () => { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; } };
    if (bc) bc.onmessage = (e) => listeners.forEach((f) => f(e.data));
    window.addEventListener('storage', (e) => {
      if (e.key === KEY && e.newValue) { try { listeners.forEach((f) => f(JSON.parse(e.newValue))); } catch (_) {} }
    });
    return {
      kind: 'local',
      publish(s) { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) {} if (bc) bc.postMessage(s); listeners.forEach((f) => f(s)); },
      onChange(cb) { listeners.push(cb); const s = read(); if (s) cb(s); },
    };
  }

  async function firebaseNet(cfg) {
    const appMod = await import('https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js');
    const dbMod = await import('https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js');
    const app = appMod.initializeApp(cfg);
    const database = dbMod.getDatabase(app);
    const ref = dbMod.ref(database, 'fpc/room1');
    const listeners = [];
    dbMod.onValue(ref, (snap) => { const s = snap.val(); if (s) listeners.forEach((f) => f(s)); });
    return { kind: 'firebase', publish(s) { dbMod.set(ref, s); }, onChange(cb) { listeners.push(cb); } };
  }

  const publish = (s) => { state = s; net.publish(s); render(); };

  function onRemote(s) { state = s; if (sel) { const p = s.board && s.board[sel[0]] && s.board[sel[0]][sel[1]]; if (!p) sel = null; } render(); }

  // ===================== Actions =====================
  function myColor() {
    if (!state) return null;
    return COLORS.find((c) => state.seats[c] === CLIENT_ID) || null;
  }

  function claim(color) {
    const s = state ? structuredClone(state) : freshLobby();
    if (s.status !== 'lobby' || s.seats[color]) return;
    for (const k of COLORS) if (s.seats[k] === CLIENT_ID) s.seats[k] = null;
    s.seats[color] = CLIENT_ID;
    if (COLORS.every((c) => s.seats[c])) {
      publish({ status: 'playing', seats: s.seats, board: initBoard(), turn: 'R', alive: { R: true, B: true, Y: true, G: true }, winner: null, note: '' });
    } else {
      publish(s);
    }
  }

  function leave() {
    if (!state || state.status !== 'lobby') return;
    const s = structuredClone(state);
    for (const k of COLORS) if (s.seats[k] === CLIENT_ID) s.seats[k] = null;
    publish(s);
  }

  function reset() { sel = null; publish(freshLobby()); }

  function playSolo() {
    publish({ status: 'playing', seats: { R: CLIENT_ID, B: CLIENT_ID, Y: CLIENT_ID, G: CLIENT_ID }, board: initBoard(), turn: 'R', alive: { R: true, B: true, Y: true, G: true }, winner: null, note: '' });
  }

  function tryMove(fr, fc, tr, tc) {
    const s = structuredClone(state);
    let b = applyMove(s.board, fr, fc, tr, tc);
    const alive = s.alive;
    // advance to the next living army, eliminating any who have no legal reply
    let turn = nextAlive(alive, s.turn);
    let note = '';
    while (aliveCount(alive) > 1) {
      if (hasAnyLegal(b, alive, turn)) break;
      const reason = inCheck(b, alive, turn) ? 'checkmated' : 'stalemated';
      eliminate(b, alive, turn);
      note = COLOR_NAME[turn] + ' was ' + reason + '.';
      turn = nextAlive(alive, turn);
    }
    s.board = b;
    if (aliveCount(alive) <= 1) {
      s.status = 'over';
      s.winner = COLORS.find((c) => alive[c]) || null;
      s.note = note;
    } else {
      s.turn = turn;
      s.note = note;
    }
    sel = null;
    publish(s);
  }

  const canMoveNow = () => state && state.status === 'playing' && state.seats[state.turn] === CLIENT_ID;

  function onCellClick(r, c) {
    if (!canMoveNow()) return;
    const turnColor = state.turn;
    const b = state.board;
    const p = b[r][c];
    if (sel) {
      const legal = legalFrom(b, state.alive, sel[0], sel[1]).some(([mr, mc]) => mr === r && mc === c);
      if (legal) { tryMove(sel[0], sel[1], r, c); return; }
      if (p && p.c === turnColor) { sel = [r, c]; render(); return; }
      sel = null; render(); return;
    }
    if (p && p.c === turnColor) { sel = [r, c]; render(); }
  }

  // ===================== Rendering =====================
  const $ = (id) => document.getElementById(id);

  function render() {
    const statusEl = $('fpc-status');
    const lobbyEl = $('fpc-lobby');
    const boardOuter = $('fpc-board-outer');
    const modeEl = $('fpc-mode');
    if (!statusEl) return;

    modeEl.textContent = net
      ? net.kind === 'firebase'
        ? 'Online: play across devices.'
        : 'Same-device mode: open this page in another tab or window to add players.'
      : 'Connecting...';

    if (!state) { statusEl.textContent = 'Connecting...'; lobbyEl.hidden = true; boardOuter.hidden = true; return; }

    if (state.status === 'lobby') {
      const filled = COLORS.filter((c) => state.seats[c]).length;
      statusEl.textContent = 'Waiting for players. ' + filled + ' / 4 seated. The game starts automatically when all four seats are taken.';
      lobbyEl.hidden = false;
      boardOuter.hidden = true;
      lobbyEl.innerHTML = '';
      const mine = myColor();
      for (const c of COLORS) {
        const taken = state.seats[c];
        const isMine = taken === CLIENT_ID;
        const div = document.createElement('div');
        div.className = 'seat' + (isMine ? ' mine' : '');
        div.innerHTML =
          '<span class="chip" style="background:' + COLOR_HEX[c] + '"></span>' +
          '<span class="who"><b>' + COLOR_NAME[c] + '</b><small>' +
          (taken ? (isMine ? 'You' : 'Taken') : 'Open seat') + '</small></span>';
        const btn = document.createElement('button');
        if (isMine) { btn.textContent = 'Leave'; btn.onclick = leave; }
        else if (taken) { btn.textContent = 'Taken'; btn.disabled = true; btn.style.opacity = '0.5'; }
        else { btn.textContent = mine ? 'Switch here' : 'Join'; btn.onclick = () => claim(c); }
        div.appendChild(btn);
        lobbyEl.appendChild(div);
      }
      const solo = document.createElement('div');
      solo.className = 'seat';
      solo.style.gridColumn = '1 / -1';
      solo.innerHTML = '<span class="who"><b>On your own?</b><small>Play all four colours yourself on this device (pass and play).</small></span>';
      const sb = document.createElement('button');
      sb.textContent = 'Play solo';
      sb.onclick = playSolo;
      solo.appendChild(sb);
      lobbyEl.appendChild(solo);
      return;
    }

    // playing or over
    lobbyEl.hidden = true;
    boardOuter.hidden = false;
    const mine = myColor();
    if (state.status === 'over') {
      statusEl.innerHTML =
        (state.winner ? '<span class="turn-dot" style="background:' + COLOR_HEX[state.winner] + '"></span>' + COLOR_NAME[state.winner] + ' wins.' : 'Game over.') +
        (state.note ? ' ' + state.note : '');
    } else {
      const yourTurn = state.seats[state.turn] === CLIENT_ID;
      statusEl.innerHTML =
        '<span class="turn-dot" style="background:' + COLOR_HEX[state.turn] + '"></span>' +
        COLOR_NAME[state.turn] + ' to move.' +
        (yourTurn ? ' <b>Your move.</b>' : mine ? ' You are ' + COLOR_NAME[mine] + '.' : ' (spectating)') +
        (state.note ? ' ' + state.note : '');
    }

    const b = state.board;
    const legalTargets = sel ? legalFrom(b, state.alive, sel[0], sel[1]) : [];
    const checkSquares = {};
    if (state.status === 'playing') {
      for (const c of COLORS) if (state.alive[c] && inCheck(b, state.alive, c)) { const k = kingPos(b, c); if (k) checkSquares[k[0] + ',' + k[1]] = true; }
    }

    const boardEl = $('fpc-board');
    boardEl.innerHTML = '';
    const canPlay = canMoveNow();
    for (let r = 0; r < 14; r++) {
      for (let c = 0; c < 14; c++) {
        const cell = document.createElement('div');
        if (off(r, c)) { cell.className = 'cell void'; boardEl.appendChild(cell); continue; }
        let cls = 'cell ' + ((r + c) % 2 ? 'darksq' : 'lightsq');
        const p = b[r][c];
        if (sel && sel[0] === r && sel[1] === c) cls += ' sel';
        const target = legalTargets.find(([mr, mc]) => mr === r && mc === c);
        if (target) cls += p ? ' capture' : ' move';
        if (checkSquares[r + ',' + c]) cls += ' check';
        if (canPlay && p && p.c === state.turn) cls += ' playable';
        else if (target) cls += ' playable';
        cell.className = cls;
        if (p) {
          const dead = !state.alive || !state.alive[p.c];
          cell.innerHTML = '<span class="pc ' + p.c + (dead ? ' dead' : '') + '">' + GLYPH[p.t] + '</span>';
        }
        cell.addEventListener('click', () => onCellClick(r, c));
        boardEl.appendChild(cell);
      }
    }
  }

  // ===================== Boot =====================
  (async () => {
    try { net = FIREBASE_CONFIG ? await firebaseNet(FIREBASE_CONFIG) : localNet(); }
    catch (e) { net = localNet(); }
    net.onChange(onRemote);
    const rb = $('fpc-reset');
    if (rb) rb.addEventListener('click', reset);
    // No shared table yet: show a local lobby so this client can seat itself.
    if (!state) state = freshLobby();
    render();
  })();
</script>
